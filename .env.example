# Final public HTTPS domain. Drives canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional public JSON-compatible form endpoint (Formspree, EmailJS proxy, custom API). Never place secret keys here.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Optional Google Analytics measurement ID (G-XXXXXXX). Loaded only after the visitor accepts the consent banner.
NEXT_PUBLIC_GA_ID=
